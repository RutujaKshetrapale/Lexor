# ==============================================================================
# LEXOR — AI-Powered Smart Mobility Platform
# Global Environment Variables Template (.env.example)
#
# IMPORTANT:
# 1. Copy this template to .env or local environment files:
#    - Spring Boot: application-local.yml or environment variables
#    - .NET: appsettings.Local.json or environment variables
# 2. NEVER commit actual passwords, private keys, or credentials to Git.
# 3. All passwords and keys shown below are placeholders and MUST be replaced.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Infrastructure & Database (MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=lexor_user
DB_PASSWORD=your_strong_mysql_password_here

# Spring Boot Datasource Mapping
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# .NET Database Connection String Mapping
ConnectionStrings__DefaultConnection=Server=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};User=${DB_USERNAME};Password=${DB_PASSWORD};CharSet=utf8mb4;

# Redis Caching & In-Memory Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here

# ------------------------------------------------------------------------------
# 2. JWT Cryptographic Security (HS256 - Minimum 256 bits / 32 characters)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit secret using:
# openssl rand -base64 32
JWT_SECRET=your_cryptographically_strong_random_jwt_secret_min_32_chars_here
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Microservice Internal Service Authentication
# ------------------------------------------------------------------------------
# High-entropy shared secret for internal service-to-service communication via X-Internal-Service-Key
# Generate using: openssl rand -hex 32
INTERNAL_SERVICE_API_KEY=your_cryptographically_random_internal_service_key_here
LEXOR_INTERNAL_SERVICE_KEY=${INTERNAL_SERVICE_API_KEY}

# ------------------------------------------------------------------------------
# 4. API Gateway & CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPLENISH_RATE=50
RATE_LIMIT_BURST_CAPACITY=100

# ------------------------------------------------------------------------------
# 5. Service Port Mapping (Spring Boot: 8080-8103, .NET: 8081-8104)
# ------------------------------------------------------------------------------
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8083
DRIVER_SERVICE_URL=http://localhost:8085
VEHICLE_SERVICE_URL=http://localhost:8087
RIDE_TYPE_SERVICE_URL=http://localhost:8089
RIDE_REQUEST_SERVICE_URL=http://localhost:8091
DRIVER_MATCHING_SERVICE_URL=http://localhost:8093
BOOKING_SERVICE_URL=http://localhost:8095
PAYMENT_SERVICE_URL=http://localhost:8097
NOTIFICATION_SERVICE_URL=http://localhost:8099
FEEDBACK_SERVICE_URL=http://localhost:8101
ADMIN_OPERATIONS_SERVICE_URL=http://localhost:8103

# ------------------------------------------------------------------------------
# 6. External SMS & OTP Delivery Providers (Notification Service)
# ------------------------------------------------------------------------------
# Selected SMS Provider: MSG91, TWILIO, MSG91_SANDBOX, TWILIO_SANDBOX
SMS_PROVIDER=MSG91_SANDBOX

# MSG91 Configuration (Primary India-oriented SMS & OTP delivery)
# Obtain from: https://control.msg91.com/ -> Dashboard -> Authkey & Flow/Templates
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here
MSG91_SENDER_ID=LEXORS
MSG91_OTP_EXPIRY_MINUTES=5

# Twilio Configuration (Extensible alternative SMS provider)
# Obtain from: https://console.twilio.com/ -> Account SID, Auth Token & Phone Numbers
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006

# ------------------------------------------------------------------------------
# 7. Push Notifications (Firebase Cloud Messaging - FCM)
# ------------------------------------------------------------------------------
# Backend FCM Server Configuration
# Obtain from: Firebase Console -> Project Settings -> Cloud Messaging / Service Accounts
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_PROJECT_ID=lexor-mobility-sandbox
# Optional Google Service Account JSON path for FCM HTTP v1 API:
FCM_SERVICE_ACCOUNT_KEY_PATH=/path/to/firebase-service-account.json

# ------------------------------------------------------------------------------
# 8. Digital Payments Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Payment Provider: RAZORPAY (default)
PAYMENT_PROVIDER=RAZORPAY

# Backend Razorpay Credentials
# Obtain from: https://dashboard.razorpay.com/ -> Settings -> API Keys & Webhooks
# IMPORTANT: Keep KEY_SECRET and WEBHOOK_SECRET private on the backend ONLY!
RAZORPAY_KEY_ID=rzp_test_sample_key_123456
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PAYMENT_COMMISSION_PERCENT=20.00
PAYMENT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 9. Maps, Geocoding & Real-Time Navigation
# ------------------------------------------------------------------------------
# Map Routing Provider: OSM (OpenStreetMap / OSRM - default), GOOGLE, MAPBOX
MAP_PROVIDER=OSM

# Google Maps Platform (Directions, Geocoding, Places Autocomplete)
# Obtain from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Server-side / Geocoding Key (Backend routing):
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_api_key_here

# Mapbox Navigation (Alternative mapping engine)
# Obtain from: https://account.mapbox.com/ -> Tokens
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ------------------------------------------------------------------------------
# 10. Frontend Client Environment Variables (Vite - .env in frontend/)
# ------------------------------------------------------------------------------
# Browser-restricted map key (Restrict HTTP referrers in Google Cloud Console)
VITE_GOOGLE_MAPS_KEY=your_browser_restricted_google_maps_key_here
VITE_MAPBOX_TOKEN=your_public_mapbox_token_here

# Razorpay Client-Side Key ID (Safe for frontend; NEVER expose key_secret!)
VITE_RAZORPAY_KEY_ID=rzp_test_sample_key_123456

# Firebase Cloud Messaging Client Configuration (Web Push SDK)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_PROJECT_ID=lexor-mobility-sandbox
VITE_FIREBASE_MESSAGING_SENDER_ID=your_fcm_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_VAPID_KEY=your_fcm_vapid_key_pair_here

# ------------------------------------------------------------------------------
# 11. SMTP Email Delivery (Notification Service)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=SMTP_SANDBOX
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM_ADDRESS=no-reply@lexor.com
EMAIL_FROM_NAME=LEXOR Mobility

