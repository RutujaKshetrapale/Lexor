# =============================================================================
# LEXOR Ride Type Service (.NET) Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# =============================================================================

# Service Port
PORT=8090
ASPNETCORE_URLS=http://+:8090

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_database_password_here;AllowPublicKeyRetrieval=True;SSLMode=None;
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_database_password_here;AllowPublicKeyRetrieval=True;SSLMode=None;

# JWT Security
# Must be at least 256 bits (32 bytes) hex-encoded secret matching Auth Service
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
Jwt__Secret=your_jwt_signing_secret_min_32_chars_here
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR
