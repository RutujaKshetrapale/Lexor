# =============================================================================
# LEXOR Payment Service — ASP.NET Core Environment Configuration Template
# =============================================================================

# Server Port
PORT=8098

# Database Connection (MySQL 8)
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_secure_db_password;AllowPublicKeyRetrieval=True;SSLMode=None;

# JWT Security (Must match LEXOR Auth Service signing key)
JWT__SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLWtleS1mb3ItbGV4b3Itc21hcnQtbW9iaWxpdHktMjAyNC1qd3QtdG9rZW4tc2VjcmV0LWtleQ==
JWT__ISSUER=LEXOR
JWT__AUDIENCE=LEXOR
JWT__EXPIRATIONMINUTES=1440

# Downstream Microservices
SERVICES__BOOKINGURL=http://localhost:8096
SERVICES__TIMEOUTSECONDS=5

# Payment Gateway Configuration (Razorpay Sandbox/Test)
PAYMENT__PROVIDER=RAZORPAY
PAYMENT__COMMISSIONPERCENTAGE=20.00
PAYMENT__CURRENCY=INR
PAYMENT__RAZORPAY__KEYID=rzp_test_sample_key_123456
PAYMENT__RAZORPAY__KEYSECRET=sample_razorpay_secret_654321
PAYMENT__RAZORPAY__WEBHOOKSECRET=sample_webhook_secret_987654
