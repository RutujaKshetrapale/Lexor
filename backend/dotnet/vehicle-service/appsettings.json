{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=YOUR_DB_PASSWORD;AllowPublicKeyRetrieval=True;SSLMode=None;"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "LEXOR",
    "Audience": "LEXOR",
    "ExpirationMinutes": 1440
  },
  "Storage": {
    "Location": "uploads/vehicle-documents",
    "AllowedExtensions": "pdf,jpg,jpeg,png,webp",
    "MaxFileSizeBytes": 10485760
  },
  "VerificationPolicy": {
    "RequiredDocuments": "REGISTRATION_CERTIFICATE,VEHICLE_INSURANCE,POLLUTION_UNDER_CONTROL"
  }
}
