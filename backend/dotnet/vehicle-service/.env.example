# =============================================================================
# LEXOR — AI-Powered Smart Mobility Platform
# Vehicle Service (.NET Microservice) Environment Configuration
# =============================================================================

# Server Port
PORT=8088
ASPNETCORE_URLS=http://+:8088
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (MySQL 8 / lexor_db)
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_database_password_here;AllowPublicKeyRetrieval=True;SSLMode=None;
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_database_password_here;AllowPublicKeyRetrieval=True;SSLMode=None;

# JWT Security
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
Jwt__Secret=your_jwt_signing_secret_min_32_chars_here
Jwt__Issuer=LEXOR
Jwt__Audience=LEXOR
Jwt__ExpirationMinutes=1440

# Document Storage
Storage__Location=uploads/vehicle-documents
Storage__AllowedExtensions=pdf,jpg,jpeg,png,webp
Storage__MaxFileSizeBytes=10485760

# Verification Policy (Mandatory compliance documents required for vehicle approval)
VerificationPolicy__RequiredDocuments=REGISTRATION_CERTIFICATE,VEHICLE_INSURANCE,POLLUTION_UNDER_CONTROL
