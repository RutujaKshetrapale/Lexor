{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "lexor-default-jwt-secret-key-32-chars-long!",
    "Issuer": "LEXOR",
    "Audience": "LEXOR"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "RateLimiting": {
    "PermitLimit": 50,
    "QueueLimit": 0,
    "WindowSeconds": 1
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "user-users-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "user-riders-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/v1/riders/{**catch-all}"
        }
      },
      "booking-driver-route": {
        "ClusterId": "booking-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/drivers/me/bookings/{**catch-all}"
        }
      },
      "driver-matching-location-route": {
        "ClusterId": "driver-matching-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v1/drivers/me/location/{**catch-all}"
        }
      },
      "driver-route": {
        "ClusterId": "driver-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/v1/drivers/{**catch-all}"
        }
      },
      "driver-admin-route": {
        "ClusterId": "driver-cluster",
        "Match": {
          "Path": "/api/v1/admin/drivers/{**catch-all}"
        }
      },
      "vehicle-route": {
        "ClusterId": "vehicle-cluster",
        "Match": {
          "Path": "/api/v1/vehicles/{**catch-all}"
        }
      },
      "vehicle-admin-route": {
        "ClusterId": "vehicle-cluster",
        "Match": {
          "Path": "/api/v1/admin/vehicles/{**catch-all}"
        }
      },
      "ride-type-route": {
        "ClusterId": "ride-type-cluster",
        "Match": {
          "Path": "/api/v1/ride-types/{**catch-all}"
        }
      },
      "ride-type-admin-route": {
        "ClusterId": "ride-type-cluster",
        "Match": {
          "Path": "/api/v1/admin/ride-types/{**catch-all}"
        }
      },
      "ride-request-route": {
        "ClusterId": "ride-request-cluster",
        "Match": {
          "Path": "/api/v1/ride-requests/{**catch-all}"
        }
      },
      "ride-request-admin-route": {
        "ClusterId": "ride-request-cluster",
        "Match": {
          "Path": "/api/v1/admin/ride-requests/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}"
        }
      },
      "booking-admin-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/admin/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8084"
          }
        }
      },
      "driver-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8086"
          }
        }
      },
      "vehicle-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8088"
          }
        }
      },
      "ride-type-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8090"
          }
        }
      },
      "ride-request-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8092"
          }
        }
      },
      "driver-matching-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8094"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8096"
          }
        }
      }
    }
  }
}
