# =============================================================================
# LEXOR Ride Request Service (.NET) Environment Variables Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# =============================================================================

# Service Port
PORT=8092
ASPNETCORE_URLS=http://+:8092
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=lexor_db;Uid=root;Pwd=your_database_password_here;AllowPublicKeyRetrieval=True;SSLMode=None;

# JWT Security
# Must be at least 256 bits (32 bytes) hex-encoded secret shared with auth-service
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR

# External Services
RIDE_TYPE_SERVICE_URL=http://localhost:8089
