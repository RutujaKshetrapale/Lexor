# =============================================================================
# LEXOR .NET Notification Service — Environment Configuration Template
# =============================================================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8100

# Database Connection
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=lexor_db;User=lexor_user;Password=lexor_secure_password_2026;CharSet=utf8mb4;

# JWT Security
JwtSettings__Secret=lexor-default-jwt-secret-key-32-chars-long!
JwtSettings__Issuer=LEXOR
JwtSettings__Audience=LEXOR
InternalServiceKey=lexor-internal-service-secret-key-2026

# Firebase Cloud Messaging
NotificationSettings__Fcm__Enabled=true
NotificationSettings__Fcm__ProjectId=lexor-mobility-sandbox
NotificationSettings__Fcm__ServerKey=fcm_test_server_key_sandbox

# SMS Gateway (Twilio / DLT)
NotificationSettings__Sms__Enabled=true
NotificationSettings__Sms__Provider=TWILIO_SANDBOX
NotificationSettings__Sms__AccountSid=AC_test_lexor_sid
NotificationSettings__Sms__AuthToken=auth_token_test_sandbox
NotificationSettings__Sms__FromNumber=+15005550006

# Transactional Email (SMTP / SendGrid)
NotificationSettings__Email__Enabled=true
NotificationSettings__Email__Provider=SMTP_SANDBOX
NotificationSettings__Email__FromAddress=no-reply@lexor.com
NotificationSettings__Email__FromName=LEXOR Mobility
