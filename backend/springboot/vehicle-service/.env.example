REQUIRED_DOCUMENTS=REGISTRATION_CERTIFICATE,VEHICLE_INSURANCE,POLLUTION_UNDER_CONTROL
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB
