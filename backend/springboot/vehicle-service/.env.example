# =============================================================================
# LEXOR Vehicle Microservice — Environment Variables
# =============================================================================

# Server Configuration
PORT=8087

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Authentication (Compatible with LEXOR Auth & Driver Services)
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR

# Document Storage & Compliance Policy
STORAGE_LOCATION=uploads/vehicle-documents
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp
REQUIRED_DOCUMENTS=REGISTRATION_CERTIFICATE,VEHICLE_INSURANCE,POLLUTION_UNDER_CONTROL
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB
