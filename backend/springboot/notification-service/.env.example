# =============================================================================
# LEXOR Notification Service — Environment Configuration Template
# =============================================================================

PORT=8099
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
NOTIFICATION_DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
NOTIFICATION_DB_USERNAME=lexor_user
NOTIFICATION_DB_PASSWORD=lexor_secure_password_2026

# JWT Security
JWT_SECRET=lexor-default-jwt-secret-key-32-chars-long!
INTERNAL_SERVICE_KEY=lexor-internal-service-secret-key-2026

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=fcm_sandbox_server_key_lexor_2026
FCM_PROJECT_ID=lexor-smart-mobility-app

# SMS Gateway (Twilio / Indian DLT Provider)
SMS_PROVIDER=TWILIO_SANDBOX
TWILIO_ACCOUNT_SID=AC_sandbox_sid_lexor
TWILIO_AUTH_TOKEN=auth_token_sandbox_lexor
TWILIO_FROM_NUMBER=+15005550006

# Transactional Email (SMTP / SendGrid)
EMAIL_PROVIDER=SMTP_SANDBOX
EMAIL_FROM_ADDRESS=notifications@lexor.com
