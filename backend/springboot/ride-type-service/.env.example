# =============================================================================
# LEXOR Ride Type Service Environment Variables Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# =============================================================================

# Service Port
PORT=8089

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security
# Must be at least 256 bits (32 bytes) hex-encoded secret shared with auth-service
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR

# Logging Level
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_RIDETYPE=DEBUG
