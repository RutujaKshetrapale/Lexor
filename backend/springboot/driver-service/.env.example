# =============================================================================
# LEXOR Driver Microservice — Environment Variables
# =============================================================================

# Server Configuration
PORT=8085

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Authentication (Compatible with LEXOR Auth Service)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Document Storage & Policy
STORAGE_LOCATION=uploads/documents
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,webp
REQUIRED_DOCUMENTS=DRIVING_LICENSE,GOVERNMENT_ID,ADDRESS_PROOF
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB
