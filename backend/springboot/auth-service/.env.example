# =============================================================================
# LEXOR Auth Service — Environment Configuration Template
# =============================================================================

# Server Port
PORT=8081

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexor_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Configuration
# Secret must be a HMAC-SHA256 hex/base64 encoded key (min 256 bits / 32 characters)
JWT_SECRET=your_jwt_signing_secret_min_32_chars_here
JWT_EXPIRATION_MS=86400000 # 24 Hours in Milliseconds
JWT_ISSUER=LEXOR
JWT_AUDIENCE=LEXOR
