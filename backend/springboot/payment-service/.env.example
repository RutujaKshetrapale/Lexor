# =============================================================================
# LEXOR Payment Service — Spring Boot Environment Configuration Template
# =============================================================================

# Server Port
PORT=8097

# Database Connection (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/lexor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_secure_db_password

# JWT Security (Must match LEXOR Auth Service signing key)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLWtleS1mb3ItbGV4b3Itc21hcnQtbW9iaWxpdHktMjAyNC1qd3QtdG9rZW4tc2VjcmV0LWtleQ==
JWT_EXPIRATION_MS=86400000

# Downstream Microservices
BOOKING_SERVICE_URL=http://localhost:8095
DOWNSTREAM_TIMEOUT_SECONDS=5

# Payment Gateway Configuration (Razorpay Sandbox/Test)
PAYMENT_PROVIDER=RAZORPAY
PLATFORM_COMMISSION_PERCENTAGE=20.00
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=rzp_test_sample_key_123456
RAZORPAY_KEY_SECRET=sample_razorpay_secret_654321
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_987654
